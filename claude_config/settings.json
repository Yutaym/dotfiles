{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [],
    "additionalDirectories": []
  },
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "theme": "dark-daltonized",
  "feedbackSurveyState": {
    "lastShownTime": 1756260069338
  },
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true,
  "effortLevel": "medium",
  "statusLine": {
    "type": "command",
    "command": "sh ~/dotfiles/claude_config/statusline.sh",
    "refreshInterval": 60
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "sh ~/dotfiles/claude_config/statusline.sh subagent-statusline.mjs"
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "teammateMode": "auto",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ -x \"$f\" ] || exit 0; exec \"$f\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ -x \"$f\" ] || exit 0; exec \"$f\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ -x \"$f\" ] || exit 0; exec \"$f\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ -x \"$f\" ] || exit 0; exec \"$f\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ -x \"$f\" ] || exit 0; exec \"$f\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ -x \"$f\" ] || exit 0; exec \"$f\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ -x \"$f\" ] || exit 0; exec \"$f\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; exec node \"$HOME/dotfiles/claude_config/hooks/meta-save-check.mjs\" stop"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ -x \"$f\" ] || exit 0; exec \"$f\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ -x \"$f\" ] || exit 0; exec \"$f\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ -x \"$f\" ] || exit 0; exec \"$f\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; exec node \"$HOME/dotfiles/claude_config/hooks/meta-save-check.mjs\" prompt"
          }
        ]
      }
    ]
  }
}
