{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "permissions": {
    "allow": [],
    "additionalDirectories": []
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ -x \"$f\" ] || exit 0; exec \"$f\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ -x \"$f\" ] || exit 0; exec \"$f\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ -x \"$f\" ] || exit 0; exec \"$f\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ -x \"$f\" ] || exit 0; exec \"$f\""
          }
        ]
      },
      {
        "matcher": "Bash|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; exec node \"$HOME/dotfiles/claude_config/hooks/pretool-guard.mjs\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ -x \"$f\" ] || exit 0; exec \"$f\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ -x \"$f\" ] || exit 0; exec \"$f\""
          },
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; exec node \"$HOME/dotfiles/claude_config/hooks/calendar-unread.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; exec node \"$HOME/dotfiles/claude_config/hooks/model-settings-add.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; exec node \"$HOME/dotfiles/claude_config/hooks/session-main.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ -x \"$f\" ] || exit 0; exec \"$f\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; exec node \"$HOME/dotfiles/claude_config/hooks/context-clear-notice.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; exec node \"$HOME/dotfiles/claude_config/hooks/wiki-save-check.mjs\" stop"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; exec node \"$HOME/dotfiles/claude_config/hooks/session-main-auto-clear.mjs\" stop",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ -x \"$f\" ] || exit 0; exec \"$f\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ -x \"$f\" ] || exit 0; exec \"$f\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ -x \"$f\" ] || exit 0; exec \"$f\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; exec node \"$HOME/dotfiles/claude_config/hooks/wiki-save-check.mjs\" prompt"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; exec node \"$HOME/dotfiles/claude_config/hooks/session-main-prompt.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; exec node \"$HOME/dotfiles/claude_config/hooks/session-main-auto-clear.mjs\" prompt",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; exec node \"$HOME/dotfiles/claude_config/hooks/session-purpose.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/dotfiles/claude_config/statusline.sh",
    "refreshInterval": 60,
    "hideVimModeIndicator": true
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "sh ~/dotfiles/claude_config/statusline.sh subagent-statusline.mjs"
  },
  "alwaysThinkingEnabled": true,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    },
    "claude-haiku-5-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-2": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "theme": "dark-daltonized",
  "editorMode": "vim",
  "vimInsertModeRemaps": {
    "jj": "<Esc>"
  },
  "teammateMode": "auto",
  "crossSessionInbound": "accept",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1756260069338
  },
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: assume private unless the remote host and repo name indicate otherwise, or a visibility check in the transcript shows public",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: (unknown — origin/HEAD unset; repo has no remotes configured)",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine with open internet",
      "**Source control**: The trusted repo (C:\\Users\\yutay\\claudeWS) only — no remotes are configured, no additional orgs configured",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development, including personal Claude Code tooling/configuration work (dotfiles, CLAUDE.md rules, hooks, session orchestration) — lean personal/hobby given subscription posture",
      "**Trusted repo**: C:\\Users\\yutay\\claudeWS (the working directory this session started in) — no remotes are currently configured, so treat it as a local-only repo for now",
      "**Org-specific CLiss**: None configured",
      "Routine under `~/dotfiles/claude_config/` and `~/.claude/` prefixes: reading and editing personal Claude Code configuration files (CLAUDE.md, hooks, rules) is routine per the user's own global rules, but changes should still be backed up to `~/.claude/backups/` before editing as the user's own docs describe"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(kubectl delete:*) — scoped to k8s test namespaces seen in this project (autoclear-test, claude-code-vim-mode, claudews-tmux-wname-cause, clear-test, rename-test, rename-test2, sendkeys-test, stackdump), given recent 'Interfere With Workloads' denials against these namespaces"
    ]
  }
}
